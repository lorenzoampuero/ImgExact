---
import { SITE } from '../config/site';
import { TOOLS } from '../data/tools';

const year = new Date().getFullYear();
const primary = ['compress-image-to-size', 'compress-image', 'resize-image', 'convert-image', 'crop-image'];
const more = ['social-image-resizer', 'signature-resizer', 'image-size-checker', 'image-metadata', 'image-dpi', 'image-to-base64'];
const bySlug = new Map(TOOLS.map((t) => [t.slug, t]));
const label = (slug: string) => bySlug.get(slug)?.name ?? slug;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__title">Why {SITE.name}</p>
        <p class="footer-note">
          Every tool runs entirely in your browser. Your images are never uploaded, there is no
          signup, and there are no limits or watermarks.
        </p>
      </div>
      <div>
        <p class="site-footer__title">Popular tools</p>
        <ul>
          {primary.map((slug) => (
            <li><a href={`/${slug}`}>{label(slug)}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="site-footer__title">More tools</p>
        <ul>
          {more.map((slug) => (
            <li><a href={`/${slug}`}>{label(slug)}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="site-footer__title">Site</p>
        <ul>
          <li><a href="/#tools">All tools</a></li>
          <li><a href="/guides">Guides</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/terms">Terms</a></li>
        </ul>
      </div>
    </div>
    <hr />
    <p class="footer-note">
      © {year} {SITE.name}. An independent image utility. Platform names (Instagram, YouTube, etc.)
      are used factually to describe image sizes — no partnership or endorsement is implied.
    </p>
  </div>
</footer>
