---
import ToolCard from './ToolCard.astro';
import { TOOL_MAP, type ToolEntry } from '../data/tools';

interface Props {
  tool: ToolEntry;
}

const { tool } = Astro.props;
const related = tool.related
  .map((slug) => TOOL_MAP.get(slug))
  .filter((t): t is ToolEntry => Boolean(t));
---

<section class="related-tools" aria-labelledby="related-heading">
  <h2 id="related-heading">You may also need</h2>
  <div class="tool-grid" style="max-width: 720px;">
    {related.map((t) => <ToolCard tool={t} />)}
  </div>
</section>
