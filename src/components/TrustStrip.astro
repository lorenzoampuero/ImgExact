---
/**
 * Real product trust signals only — no invented user counts, no fake testimonials.
 */
const items = [
  'Images never leave your device',
  'No signup, no email',
  'No file limits or watermarks',
  'Works offline once loaded',
];
---

<div class="trust-strip" role="list" aria-label="Product guarantees">
  {items.map((item) => (
    <span role="listitem">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M2.5 8.5L6 12L13.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      {item}
    </span>
  ))}
</div>
