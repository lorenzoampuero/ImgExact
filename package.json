{
  "name": "imgexact",
  "version": "0.1.0",
  "private": true,
  "description": "ImgExact — browser-first image toolkit: resize, compress, convert, crop and prepare images to exact requirements. Processing happens locally in the browser; images are never uploaded.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-fixtures.ps1 && node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
